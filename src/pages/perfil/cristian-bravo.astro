---
import ProfileLayout from '../../layouts/ProfileLayout.astro';
import ProfileHeroSection from '../../components/profile/sections/ProfileHeroSection.astro';
import ProfileDetailsSection from '../../components/profile/sections/ProfileDetailsSection.astro';
import ProfileInterestsSection from '../../components/profile/sections/ProfileInterestsSection.astro';
import {
  profileDetailCards,
  profileHeroContent,
  profileInterestsContent,
  profilePageMeta,
} from '../../data/profile';
import '../../styles/profile.css';
---
<ProfileLayout title={profilePageMeta.title} description={profilePageMeta.description}>
  <ProfileHeroSection content={profileHeroContent} />
  <ProfileDetailsSection cards={profileDetailCards} />
  <ProfileInterestsSection content={profileInterestsContent} />
</ProfileLayout>
