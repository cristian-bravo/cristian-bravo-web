---
import CystemsLayout from '../layouts/CystemsLayout.astro';
import DevelopmentRequestSection from '../components/development-request/sections/DevelopmentRequestSection.astro';
import { getData } from '../data';
import '../styles/development-request.css';

const { developmentRequest } = getData('es');
const { developmentRequestLandingContent, developmentRequestLandingPageMeta } = developmentRequest;
---
<CystemsLayout
  title={developmentRequestLandingPageMeta.title}
  description={developmentRequestLandingPageMeta.description}
>
  <DevelopmentRequestSection content={developmentRequestLandingContent} />
</CystemsLayout>

