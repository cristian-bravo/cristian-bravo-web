---
import CystemsLayout from '../layouts/CystemsLayout.astro';
import ContactOverviewSection from '../components/contact/sections/ContactOverviewSection.astro';
import { getData } from '../data';
import '../styles/contact.css';

const lang = Astro.props.lang === 'en' ? 'en' : 'es';
const { contact } = getData(lang);
const { contactOverviewContent, contactPageMeta } = contact;
---
<CystemsLayout title={contactPageMeta.title} description={contactPageMeta.description} lang={lang}>
  <ContactOverviewSection content={contactOverviewContent} />
</CystemsLayout>

