---
import CystemsLayout from '../layouts/CystemsLayout.astro';
import ServicesIntroSection from '../components/services/sections/ServicesIntroSection.astro';
import ServicesAccompanimentSection from '../components/services/sections/ServicesAccompanimentSection.astro';
import ServicesModals from '../components/services/modals/ServicesModals.astro';
import ServicesModalScript from '../components/services/modals/ServicesModalScript.astro';
import {
  serviceCards,
  serviceModals,
  servicesAccompaniment,
  servicesIntro,
  servicesPageMeta,
} from '../data/services';
import '../styles/servicios.css';
---
<CystemsLayout title={servicesPageMeta.title} description={servicesPageMeta.description}>
  <ServicesIntroSection intro={servicesIntro} cards={serviceCards} />
  <ServicesAccompanimentSection content={servicesAccompaniment} />
  <ServicesModals modals={serviceModals} />
  <ServicesModalScript />
</CystemsLayout>
