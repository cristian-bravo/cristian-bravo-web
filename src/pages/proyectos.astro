---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProjectsStory from '../components/projects/sections/ProjectsPortfolioSection.astro';
import { projectsPageMeta, projectsPortfolioContent } from '../data/projects';
import '../styles/projects.css';

const projectSteps = projectsPortfolioContent.groups.flatMap((group) => group.references);
---
<BaseLayout title={projectsPageMeta.title} description={projectsPageMeta.description}>
  <Header />
  <main class="story-root" data-story-root>
    <div class="story-scroll" data-story-scroll>
      <div class="story-stage" data-story-stage>
        <section class="projects-story portfolio-story" data-projects-story-root data-active-tone="0">
          <div class="projects-story__theme-layers" aria-hidden="true">
            <span class="projects-story__theme-layer" data-tone="0"></span>
            <span class="projects-story__theme-layer" data-tone="1"></span>
            <span class="projects-story__theme-layer" data-tone="2"></span>
            <span class="projects-story__theme-layer" data-tone="3"></span>
          </div>
          <div class="projects-story__grid-overlay" aria-hidden="true"></div>

          <aside class="projects-story-progress" aria-label="Progreso del portafolio" data-projects-progress>
            <div class="projects-story-progress__track" aria-hidden="true">
              <span class="projects-story-progress__fill" data-projects-progress-fill></span>
            </div>
            <ol class="projects-story-progress__dots">
              {projectSteps.map((project, index) => (
                <li>
                  <button
                    type="button"
                    class="projects-story-progress__dot"
                    data-project-progress-dot
                    data-step-index={index}
                    title={project.title}
                    aria-label={`Ir al proyecto ${index + 1}: ${project.title}`}
                  ></button>
                </li>
              ))}
            </ol>
          </aside>

          <div class="story-track" data-story-track>
            <ProjectsStory content={projectsPortfolioContent} />
          </div>
        </section>
      </div>
    </div>
  </main>

  <script>
    import { initScrollPortfolioAnimations } from '../scripts/scrollPortfolioAnimations';

    const resetStoryScroll = () => {
      window.scrollTo(0, 0);
    };

    let cleanup = () => {};

    const initialize = () => {
      const root = document.querySelector('[data-projects-story-root]');
      if (!root) return;

      resetStoryScroll();
      cleanup();
      cleanup = initScrollPortfolioAnimations(root);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initialize, { once: true });
    } else {
      initialize();
    }

    const onPageLoad = () => {
      initialize();
    };

    window.addEventListener('astro:page-load', onPageLoad);
    window.addEventListener(
      'astro:before-swap',
      () => {
        cleanup();
        window.removeEventListener('astro:page-load', onPageLoad);
      },
      { once: true },
    );
  </script>
</BaseLayout>
