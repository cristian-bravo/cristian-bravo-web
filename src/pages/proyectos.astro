---
import CystemsLayout from '../layouts/CystemsLayout.astro';
import ProjectsGallery from '../components/projects/ProjectsGallery.astro';
import { getData } from '../data';
const lang = Astro.props.lang === 'en' ? 'en' : 'es';
const { projectsPageMeta } = getData(lang).projects;
---
<CystemsLayout title={projectsPageMeta.title} description={projectsPageMeta.description} lang={lang}>
  <ProjectsGallery lang={lang} />
</CystemsLayout>
