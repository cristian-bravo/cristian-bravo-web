---
import CystemsLayout from '../layouts/CystemsLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
---
<CystemsLayout title="Proyectos | CYSTEMS">
  <section class="py-16 sm:py-20 lg:py-24">
    <div class="mx-auto w-full max-w-[1120px] px-4 sm:px-6">
      <div class="mb-10 grid gap-3">
        <p class="text-xs uppercase tracking-[0.22em] text-slate-500 dark:text-brand-mutedStrong">Portafolio</p>
        <h1 class="font-display text-3xl font-semibold tracking-tight text-transparent sm:text-4xl bg-gradient-to-r from-brand-purple via-brand-blue to-brand-purple bg-clip-text">
          Proyectos con impacto real
        </h1>
        <p class="max-w-2xl text-base text-slate-600 dark:text-brand-muted sm:text-lg">
          Casos públicos y menciones confidenciales que reflejan experiencia en plataformas empresariales.
        </p>
      </div>

      <div class="grid gap-8">
        <div class="grid gap-4">
          <h2 class="font-display text-2xl font-semibold tracking-tight text-slate-900 dark:text-brand-text">
            Proyectos públicos
          </h2>
          <div class="grid gap-6 md:grid-cols-2">
            <ProjectCard
              title="Fualtec"
              description="Plataforma digital para procesos industriales y operaciones B2B."
              visibility="Público"
            />
            <ProjectCard
              title="Alkosto"
              description="Integraciones de catálogo y experiencia de compra omnicanal."
              visibility="Público"
            />
            <ProjectCard
              title="NYProject"
              description="Portal de proyectos con indicadores de avance en tiempo real."
              visibility="Público"
            />
          </div>
        </div>

        <div class="grid gap-4">
          <h2 class="font-display text-2xl font-semibold tracking-tight text-slate-900 dark:text-brand-text">
            Proyectos privados (menciones)
          </h2>
          <p class="text-sm text-slate-500 dark:text-brand-muted">
            Por acuerdos de confidencialidad, compartimos solo una referencia general de estos trabajos.
          </p>
          <div class="grid gap-6 md:grid-cols-2">
            <ProjectCard
              title="360 Integration"
              description="Integraciones empresariales de alto volumen para múltiples unidades de negocio."
              visibility="Privado"
            />
            <ProjectCard
              title="Club Guías"
              description="Ecosistema privado para fidelización y contenido especializado."
              visibility="Privado"
            />
            <ProjectCard
              title="Plataformas educativas"
              description="Suite privada para formación, analítica y seguimiento académico."
              visibility="Privado"
            />
          </div>
        </div>
      </div>
    </div>
  </section>
</CystemsLayout>
