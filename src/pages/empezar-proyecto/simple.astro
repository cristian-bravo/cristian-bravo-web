import DevelopmentRequestSimpleSection from '../../components/development-request/sections/DevelopmentRequestSimpleSection.astro';
import { getData } from '../../data';
import '../../styles/development-request.css';

const { developmentRequest } = getData('es');
const { developmentRequestSimpleContent, developmentRequestSimplePageMeta } = developmentRequest;
---
