---
import CystemsLayout from '../../layouts/CystemsLayout.astro';
import DevelopmentRequestSimpleSection from '../../components/development-request/sections/DevelopmentRequestSimpleSection.astro';
import { getData } from '../../data';
import '../../styles/development-request.css';

const lang = Astro.props.lang === 'en' ? 'en' : 'es';
const { developmentRequest } = getData(lang);
const { developmentRequestSimpleContent, developmentRequestSimplePageMeta } = developmentRequest;
---
<CystemsLayout title={developmentRequestSimplePageMeta.title} description={developmentRequestSimplePageMeta.description} lang={lang}>
  <DevelopmentRequestSimpleSection content={developmentRequestSimpleContent} />
</CystemsLayout>

