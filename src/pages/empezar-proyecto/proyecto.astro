---
import CystemsLayout from '../../layouts/CystemsLayout.astro';
import DevelopmentRequestProjectSection from '../../components/development-request/sections/DevelopmentRequestProjectSection.astro';
import { getData } from '../../data';
import '../../styles/development-request.css';
import '../../styles/servicios.css';

const lang = Astro.props.lang === 'en' ? 'en' : 'es';
const { developmentRequest } = getData(lang);
const { developmentRequestProjectContent, developmentRequestProjectPageMeta } = developmentRequest;
---
<CystemsLayout title={developmentRequestProjectPageMeta.title} description={developmentRequestProjectPageMeta.description} lang={lang}>
  <DevelopmentRequestProjectSection content={developmentRequestProjectContent} />
</CystemsLayout>

