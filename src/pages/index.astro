---
import CystemsLayout from '../layouts/CystemsLayout.astro';
import HomeHeroSection from '../components/home/sections/HomeHeroSection.astro';
import HomeServicesPreviewSection from '../components/home/sections/HomeServicesPreviewSection.astro';
import HomeMethodSection from '../components/home/sections/HomeMethodSection.astro';
import HomeNextStepSection from '../components/home/sections/HomeNextStepSection.astro';
import { getData } from '../data';
import '../styles/home.css';

const { home } = getData('es');
const {
  homeHeroContent,
  homeMethodContent,
  homeNextStepContent,
  homePageMeta,
  homeServicesPreviewContent,
} = home;
---
<CystemsLayout title={homePageMeta.title} description={homePageMeta.description}>
  <HomeHeroSection content={homeHeroContent} />
  <HomeServicesPreviewSection content={homeServicesPreviewContent} />
  <HomeMethodSection content={homeMethodContent} />
  <HomeNextStepSection content={homeNextStepContent} />
</CystemsLayout>

