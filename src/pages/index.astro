---
import CystemsLayout from '../layouts/CystemsLayout.astro';
import StudioHome from '../components/home/StudioHome.astro';
import { getData } from '../data';

const lang = Astro.props.lang === 'en' ? 'en' : 'es';
const { home } = getData(lang);
const { homePageMeta } = home;
---
<CystemsLayout title={homePageMeta.title} description={homePageMeta.description} lang={lang}>
  <StudioHome lang={lang} />
</CystemsLayout>

