---
import '../styles/global.css';

const { title = 'CYSTEMS', description = 'Soluciones tecnológicas modernas' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      const storageKey = 'theme';
      const root = document.documentElement;
      const toggleSelector = '[data-theme-toggle]';

      const safeStorage = {
        get() {
          try {
            return localStorage.getItem(storageKey);
          } catch (error) {
            return null;
          }
        },
        set(value) {
          try {
            localStorage.setItem(storageKey, value);
          } catch (error) {
            // Ignore storage errors (privacy modes, disabled storage).
          }
        },
      };

      const normalizeTheme = (value) => (value === 'dark' ? 'dark' : 'light');
      const getPreferredTheme = () =>
        window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      const setToggleState = (theme) => {
        const toggle = document.querySelector(toggleSelector);
        if (!toggle) return;
        const isDark = theme === 'dark';
        toggle.setAttribute('data-theme', theme);
        toggle.setAttribute('aria-pressed', String(isDark));
        toggle.setAttribute('aria-label', isDark ? 'Activar modo claro' : 'Activar modo oscuro');
        toggle.setAttribute('title', isDark ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro');
      };

      const applyTheme = (value, persist) => {
        const theme = normalizeTheme(value);
        root.classList.toggle('dark', theme === 'dark');
        root.style.colorScheme = theme;
        root.setAttribute('data-theme', theme);
        if (persist) {
          safeStorage.set(theme);
        }
        setToggleState(theme);
      };

      const initialTheme = safeStorage.get() || getPreferredTheme();
      applyTheme(initialTheme, false);

      const bindToggle = () => {
        const toggle = document.querySelector(toggleSelector);
        if (!toggle || toggle.dataset.themeBound === 'true') return;
        toggle.dataset.themeBound = 'true';
        setToggleState(root.classList.contains('dark') ? 'dark' : 'light');
        toggle.addEventListener('click', () => {
          const isDark = root.classList.contains('dark');
          applyTheme(isDark ? 'light' : 'dark', true);
        });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bindToggle, { once: true });
      } else {
        bindToggle();
      }

      window.addEventListener('astro:page-load', bindToggle);

      if (window.matchMedia) {
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        media.addEventListener?.('change', (event) => {
          if (!safeStorage.get()) {
            applyTheme(event.matches ? 'dark' : 'light', false);
          }
        });
      }

      window.addEventListener('storage', (event) => {
        if (event.key === storageKey) {
          applyTheme(event.newValue || getPreferredTheme(), false);
        }
      });
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&family=Sora:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="min-h-screen bg-tech font-sans text-slate-900 antialiased leading-relaxed transition-colors duration-300 selection:bg-brand-purple/40 selection:text-white dark:text-brand-text"
  >
    <slot />
  </body>
</html>
