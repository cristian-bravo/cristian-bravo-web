---
const { title = 'CYSTEMS', description = 'Soluciones tecnológicas modernas' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style>
      :root {
        --purple: #6b2cff;
        --blue: #3a7cff;
        --ink: #0f1020;
        --muted: #5a5f7a;
        --bg: #f6f4ff;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
        color: var(--ink);
        background: var(--bg);
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .container {
        width: min(1100px, 92%);
        margin: 0 auto;
      }

      .section {
        padding: 64px 0;
      }

      .gradient-text {
        background: linear-gradient(120deg, var(--purple), var(--blue));
        -webkit-background-clip: text;
        color: transparent;
      }

      .button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        border-radius: 999px;
        background: linear-gradient(120deg, var(--purple), var(--blue));
        color: white;
        font-weight: 600;
      }

      .card {
        background: white;
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 20px 40px rgba(23, 18, 71, 0.08);
      }

      .grid {
        display: grid;
        gap: 24px;
      }

      .grid-3 {
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      }

      .grid-2 {
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
