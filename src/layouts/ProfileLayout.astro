---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../data';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
}

const {
  title = 'Perfil | Cristian Bravo',
  description = 'Perfil profesional, experiencia y enfoque técnico en CYSTEMS.',
  lang = 'es',
} = Astro.props;
const cspNonce = Astro.locals.cspNonce ?? '';
---
<BaseLayout title={title} description={description} lang={lang}>
  <Header transparent lang={lang} />
  <main id="main-content" tabindex="-1" class="min-h-[60vh]">
    <slot />
  </main>
  <script is:inline nonce={cspNonce}>
    (() => {
      const setupProfileNavbar = () => {
        window.__profileNavbarCleanup?.();

        const header = document.querySelector('[data-profile-navbar]');
        const hero = document.querySelector('[data-profile-hero]');
        if (!header || !hero) return;

        let rafId = 0;

        const updateNavbarState = () => {
          rafId = 0;
          const headerHeight = header.getBoundingClientRect().height;
          hero.style.setProperty('--profile-header-height', `${headerHeight}px`);
          const threshold = headerHeight + 16;
          const isScrolled = hero.getBoundingClientRect().bottom <= threshold;
          header.classList.toggle('is-scrolled', isScrolled);
        };

        const requestUpdate = () => {
          if (rafId) return;
          rafId = window.requestAnimationFrame(updateNavbarState);
        };

        const onScroll = () => requestUpdate();
        const onResize = () => requestUpdate();

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onResize);
        requestUpdate();

        window.__profileNavbarCleanup = () => {
          if (rafId) {
            window.cancelAnimationFrame(rafId);
            rafId = 0;
          }
          header.classList.remove('is-scrolled');
          window.removeEventListener('scroll', onScroll);
          window.removeEventListener('resize', onResize);
        };
      };

      if (!window.__profileNavbarBound) {
        window.__profileNavbarBound = true;
        window.addEventListener('astro:page-load', setupProfileNavbar);
        window.addEventListener('astro:before-swap', () => {
          window.__profileNavbarCleanup?.();
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          setupProfileNavbar();
        }, { once: true });
      } else {
        setupProfileNavbar();
      }
    })();
  </script>
  <Footer lang={lang} />
</BaseLayout>
