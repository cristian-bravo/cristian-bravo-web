---
import SectionHeader from '../../shared/SectionHeader.astro';
import type { ContactOverviewContent } from '../../../data';

interface Props {
  content: ContactOverviewContent;
}

const { content } = Astro.props;
const emailHref = `mailto:${content.emailValue}`;
---
<section class="contact-overview-section py-16 sm:py-20 lg:py-24">
  <div class="mx-auto w-full max-w-[1120px] px-4 sm:px-6">
    <div class="grid items-start gap-10 lg:grid-cols-[1.1fr,0.9fr]">
      <div class="grid gap-4">
        <SectionHeader
          content={content.header}
          headingTag="h1"
          className="grid gap-4"
          descriptionClassName="max-w-xl text-base text-slate-600 dark:text-brand-muted sm:text-lg"
        />
        <div class="flex flex-wrap gap-2">
          {content.badges.map((badge) => (
            <span class="rounded-full border border-slate-200/80 bg-white/70 px-4 py-1 text-xs font-semibold text-slate-600 shadow-sm backdrop-blur-sm dark:border-brand-purple/30 dark:bg-white/5 dark:text-brand-muted">
              {badge}
            </span>
          ))}
        </div>
      </div>
      <div class="group relative overflow-hidden rounded-3xl border border-slate-200/70 bg-white/80 p-6 shadow-lg shadow-slate-900/10 backdrop-blur-sm dark:border-brand-purple/20 dark:bg-white/5 dark:shadow-glow">
        <div class="pointer-events-none absolute inset-0 opacity-40">
          <div class="absolute inset-0 bg-gradient-to-br from-brand-purple/15 via-transparent to-brand-blue/10"></div>
        </div>
        <div class="relative z-10 grid gap-4">
          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-slate-500 dark:text-brand-mutedStrong">
              {content.emailLabel}
            </p>
            <a
              class="mt-2 inline-flex text-base font-semibold text-slate-900 transition-colors hover:text-brand-purple focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple/40 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-50 dark:text-brand-text dark:hover:text-blue-200 dark:focus-visible:ring-offset-brand-bg"
              href={emailHref}
            >
              {content.emailValue}
            </a>
          </div>
          <p class="text-sm text-slate-600 dark:text-brand-muted">{content.panelDescription}</p>
          <div class="flex flex-wrap gap-3">
            <a
              class="inline-flex items-center justify-center rounded-full bg-brand-gradient px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-slate-900/10 transition hover:-translate-y-0.5 hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple/50 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-50 dark:shadow-glow dark:focus-visible:ring-offset-brand-bg"
              href={content.primaryAction.href}
            >
              {content.primaryAction.label}
            </a>
            <a
              class="inline-flex items-center justify-center rounded-full border border-slate-200/70 bg-white/70 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-brand-purple/40 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple/40 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-50 dark:border-brand-purple/40 dark:bg-white/5 dark:text-brand-text dark:hover:border-brand-purple/60 dark:focus-visible:ring-offset-brand-bg"
              href={content.secondaryAction.href}
            >
              {content.secondaryAction.label}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

