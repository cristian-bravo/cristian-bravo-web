---
import type { Lang } from '../../data';
import { getStudioContent } from '../../data/studio';
import { localizePath } from '../../lib/i18n';
import '../../styles/studio.css';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = getStudioContent(lang);
const href = (path: string) => localizePath(path, lang);
---

<div class="studio-home">
  <section class="studio-hero studio-wrap" aria-labelledby="studio-title">
    <div class="studio-hero__copy">
      <p class="studio-eyebrow">
        <span class="studio-marker" aria-hidden="true"></span>
        {c.eyebrow}
      </p>
      <h1 id="studio-title">
        {c.title}
        <br />
        <span>{c.titleAccent}</span>
      </h1>
      <p class="studio-hero__intro">{c.intro}</p>
      <p class="studio-hero__detail">{c.detail}</p>
      <div class="studio-actions">
        <a
          class="studio-button"
          href={href('/empezar-proyecto')}
          data-analytics-event="hero_cta"
          data-analytics-location="hero"
        >
          {c.cta}
          <span aria-hidden="true">↗</span>
        </a>
        <a class="studio-text-link" href={href('/proyectos')}>
          {c.projectsCta}
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <p class="studio-note">{c.note}</p>
    </div>
    <figure class="system-map" aria-label={c.diagramLabel}>
      <div class="system-map__top">
        <span class="studio-eyebrow">CYSTEMS / SYSTEM DESIGN</span>
        <span aria-hidden="true">[ 01 — 03 ]</span>
      </div>
      <p class="system-map__heading">{c.systemLabel}</p>
      <div class="system-map__inputs">
        {c.inputs.map((label, i) => (
          <span>
            <small>0{i + 1}</small>
            {label}
          </span>
        ))}
      </div>
      <svg
        class="system-map__wires"
        viewBox="0 0 360 68"
        aria-hidden="true"
        preserveAspectRatio="none"
      >
        <path d="M60 0V30Q60 38 68 38H172Q180 38 180 46V68M180 0V68M300 0V30Q300 38 292 38H188Q180 38 180 46" />
        <path class="system-map__signal" d="M180 0V68" />
      </svg>
      <div class="system-map__core">
        <span class="system-map__symbol" aria-hidden="true">
          Y<span>·</span>
        </span>
        <div>
          <strong>Yuki IA</strong>
          <span>{c.systemCaption}</span>
        </div>
        <span class="system-map__light" aria-hidden="true"></span>
      </div>
      <div class="system-map__output">
        <span aria-hidden="true">↓</span>
        {c.output}
        <span aria-hidden="true">↗</span>
      </div>
      <figcaption>{c.diagramNote}</figcaption>
    </figure>
  </section>
  <div
    class="studio-capabilities studio-wrap"
    aria-label={lang === 'en' ? 'Capabilities' : 'Capacidades'}
  >
    {c.capabilities.map((item) => (
      <span>{item}</span>
    ))}
  </div>

  <section class="studio-section studio-wrap" aria-labelledby="problems-title">
    <div class="studio-section__intro">
      <p class="studio-eyebrow">{c.problemsLabel}</p>
      <h2 id="problems-title">{c.problemsTitle}</h2>
      <p>{c.problemsIntro}</p>
    </div>
    <div class="studio-problems">
      {c.problems.map(([title, body], index) => (
        <article>
          <span class="studio-index">/0{index + 1}</span>
          <div>
            <h3>{title}</h3>
            <p>{body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="studio-services" aria-labelledby="services-title">
    <div class="studio-wrap">
      <div class="studio-section__intro">
        <p class="studio-eyebrow">{c.servicesLabel}</p>
        <h2 id="services-title">{c.servicesTitle}</h2>
      </div>
      <div class="studio-service-list">
        {c.services.map(([number, title, description]) => (
          <a href={href('/servicios')} class="studio-service">
            <span class="studio-index">{number}</span>
            <h3>{title}</h3>
            <p>{description}</p>
            <span class="studio-service__arrow" aria-hidden="true">
              ↗
            </span>
            <span class="sr-only">{c.serviceCta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section
    class="studio-rescue studio-section studio-wrap"
    aria-labelledby="rescue-title"
  >
    <div class="studio-section__intro">
      <p class="studio-eyebrow">{c.rescueLabel}</p>
      <h2 id="rescue-title">{c.rescueTitle}</h2>
      <p>{c.rescueIntro}</p>
      <a
        class="studio-text-link"
        href={href('/empezar-proyecto/simple?intent=rescue')}
      >
        {c.rescueCta}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="studio-rescue__diagnosis">
      <ul>
        {c.rescueSignals.map((signal) => (
          <li>{signal}</li>
        ))}
      </ul>
      <p>{c.rescueOutcome}</p>
    </div>
  </section>

  <section class="studio-section studio-wrap" aria-labelledby="work-title">
    <div class="studio-section__intro">
      <p class="studio-eyebrow">{c.workLabel}</p>
      <h2 id="work-title">{c.workTitle}</h2>
      <p>{c.workIntro}</p>
    </div>
    <div class="studio-cases">
      {c.cases.map((project) => (
        <article class="studio-case">
          <a
            class="studio-case__image"
            href={href(project.href)}
            target={project.href.startsWith('https:') ? '_blank' : undefined}
            rel={
              project.href.startsWith('https:')
                ? 'noopener noreferrer'
                : undefined
            }
            aria-label={`${c.caseCta}: ${project.name}`}
          >
            <img
              src={project.image}
              alt={`${project.name} — ${project.category}`}
              width="1200"
              height="750"
              loading="lazy"
              decoding="async"
            />
            <span aria-hidden="true">↗</span>
          </a>
          <p class="studio-eyebrow">{project.category}</p>
          <h3>{project.name}</h3>
          <dl>
            <div>
              <dt>{c.problem}</dt>
              <dd>{project.problem}</dd>
            </div>
            <div>
              <dt>{c.solution}</dt>
              <dd>{project.solution}</dd>
            </div>
            <div>
              <dt>{c.result}</dt>
              <dd>{project.result}</dd>
            </div>
          </dl>
        </article>
      ))}
    </div>
  </section>

  <section class="studio-ai studio-wrap" aria-labelledby="ai-title">
    <div class="studio-ai__portrait" aria-hidden="true">
      <span class="studio-ai__orbit"></span>
      <span class="studio-ai__axis"></span>
      <img
        src="/avatar/yuki_chibi.webp"
        alt=""
        width="420"
        height="420"
        loading="lazy"
        decoding="async"
      />
      <span class="studio-ai__caption">YUKI / CYSTEMS</span>
    </div>
    <div class="studio-section__intro">
      <p class="studio-eyebrow">{c.aiLabel}</p>
      <h2 id="ai-title">{c.aiTitle}</h2>
      <p>{c.aiIntro}</p>
      <ul class="studio-ai__features">
        {c.aiDetails.map((detail) => (
          <li>{detail}</li>
        ))}
      </ul>
      <button class="studio-button" type="button" data-open-yuki>
        {c.aiCta}
        <span aria-hidden="true">↗</span>
      </button>
      <p class="studio-note">
        {process.env.YUKI_SITE_CHAT_HISTORY_ENABLED === 'true'
          ? c.aiNote
          : c.aiNoteUnavailable}
      </p>
    </div>
  </section>

  <section class="studio-section studio-wrap" aria-labelledby="method-title">
    <div class="studio-section__intro">
      <p class="studio-eyebrow">{c.methodLabel}</p>
      <h2 id="method-title">{c.methodTitle}</h2>
    </div>
    <ol class="studio-method">
      {c.steps.map(([title, body], i) => (
        <li>
          <span class="studio-index">0{i + 1}</span>
          <h3>{title}</h3>
          <p>{body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="studio-founder studio-wrap" aria-labelledby="founder-title">
    <div>
      <p class="studio-eyebrow">{c.founderLabel}</p>
      <h2 id="founder-title">{c.founderTitle}</h2>
      <p class="studio-founder__role">{c.founderRole}</p>
    </div>
    <div>
      <p>{c.founderCopy}</p>
      <a class="studio-text-link" href={href('/perfil/cristian-bravo')}>
        {c.founderCta}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="studio-final studio-wrap">
    <p class="studio-eyebrow">ECUADOR · LATAM · REMOTE</p>
    <h2>{c.finalTitle}</h2>
    <p>{c.finalCopy}</p>
    <a class="studio-button" href={href('/empezar-proyecto')}>
      {c.cta}
      <span aria-hidden="true">↗</span>
    </a>
  </section>
</div>

<script>
  document.addEventListener('click', (event) => {
    if (
      event.target instanceof Element &&
      event.target.closest('[data-open-yuki]')
    ) {
      const launcher =
        document.querySelector<HTMLButtonElement>('[data-yuki-open]');
      if (launcher?.getAttribute('aria-expanded') !== 'true') launcher?.click();
      document.querySelector<HTMLTextAreaElement>('[data-yuki-input]')?.focus();
    }
  });
</script>
