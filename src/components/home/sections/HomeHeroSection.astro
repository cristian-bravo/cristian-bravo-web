---
import type { HomeHeroContent } from '../../../data';

interface Props {
  content: HomeHeroContent;
}

const { content } = Astro.props;
---
<section id="home-hero" class="home-hero-section relative -mt-32 overflow-hidden pb-14 pt-[11.5rem] sm:pb-16 sm:pt-[12rem] lg:pb-20 lg:pt-[12.75rem]">
  <div class="home-hero__background" aria-hidden="true">
    <span class="home-hero__grid"></span>
    <span class="home-hero__scanline"></span>
  </div>

  <div class="mx-auto w-full max-w-[1120px] px-4 sm:px-6">
    <div class="home-hero__layout">
      <div class="home-hero__content">
        <p class="home-hero__eyebrow">{content.kicker}</p>
        <h1 class="home-hero__title">{content.title}</h1>
        <p class="home-hero__subtitle">{content.subtitle}</p>

        <div class="home-hero__actions">
          <a class="home-hero__button home-hero__button--primary" href={content.primaryAction.href}>
            {content.primaryAction.label}
          </a>
          <a class="home-hero__button home-hero__button--secondary" href={content.secondaryAction.href}>
            {content.secondaryAction.label}
          </a>
        </div>

        <div class="home-hero__meta">
          <div>
            <p class="home-hero__meta-label">{content.focusLabel}</p>
            <p class="home-hero__meta-value">{content.focusValue}</p>
          </div>
          <div>
            <p class="home-hero__meta-label">{content.deliveryLabel}</p>
            <p class="home-hero__meta-value">{content.deliveryValue}</p>
          </div>
        </div>
      </div>

      <div class="home-hero__brand" aria-label={content.visualTitle}>
        <div class="home-hero__brand-stage">
          <div class="home-hero__brand-ring" aria-hidden="true"></div>
          <div class="home-hero__brand-mark">
            <img
              src="/logos/logo-header-ligth.webp"
              alt="CYSTEMS"
              width="440"
              height="88"
              decoding="async"
              fetchpriority="high"
            />
          </div>
          <div class="home-hero__brand-caption">
            <p>{content.visualKicker}</p>
            <h2>{content.visualTitle}</h2>
          </div>
        </div>

        <ul class="home-hero__brand-tags" aria-label={content.visualKicker}>
          {content.visualTags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
