---
import type { HomeHeroContent } from '../../../data';

interface Props {
  content: HomeHeroContent;
}

const { content } = Astro.props;
---
<section
  id="home-hero"
  class="home-hero-section hero-motion-root relative -mt-32 overflow-hidden pb-14 pt-[15rem] sm:pb-16 sm:pt-[16rem] lg:pb-20 lg:pt-[17rem]"
>
  <div class="home-hero__media" aria-hidden="true">
    <video
      class="home-hero__video home-hero__video--light"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={content.lightImageSrc}
      disablepictureinpicture
      disableremoteplayback
      tabindex="-1"
    >
      <source src="/wallpapers/videos/avatar_pets.mp4" type="video/mp4" />
    </video>
    <video
      class="home-hero__video home-hero__video--dark"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={content.darkImageSrc}
      disablepictureinpicture
      disableremoteplayback
      tabindex="-1"
    >
      <source src="/wallpapers/videos/avatar_clean.mp4" type="video/mp4" />
    </video>
    <div class="home-hero__overlay"></div>
  </div>
  <div class="hero-motion-shell mx-auto w-full max-w-[1120px] px-4 sm:px-6">
    <div class="home-hero__layout">
      <div class="hero-motion-content home-hero__content">
        <p class="home-hero__eyebrow">
          {content.kicker}
        </p>
        <h1 class="home-hero__title">
          {content.title}
        </h1>
        <p class="home-hero__subtitle">{content.subtitle}</p>
        <div class="home-hero__actions">
          <a
            class="hero-motion-btn home-hero__button home-hero__button--primary"
            href={content.primaryAction.href}
          >
            {content.primaryAction.label}
          </a>
          <a
            class="hero-motion-btn home-hero__button home-hero__button--secondary"
            href={content.secondaryAction.href}
          >
            {content.secondaryAction.label}
          </a>
        </div>
        <div class="home-hero__meta">
          <div>
            <p class="home-hero__meta-label">
              {content.focusLabel}
            </p>
            <p class="home-hero__meta-value">{content.focusValue}</p>
          </div>
          <div>
            <p class="home-hero__meta-label">
              {content.deliveryLabel}
            </p>
            <p class="home-hero__meta-value">{content.deliveryValue}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

