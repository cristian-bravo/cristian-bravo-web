---
import ServiceCard from '../../ServiceCard.astro';
import SectionHeader from '../../shared/SectionHeader.astro';
import type { HomeServicesPreviewContent } from '../../../data';

interface Props {
  content: HomeServicesPreviewContent;
}

const { content } = Astro.props;
---
<section class="services-chibi-bg home-bubbles-section hero-motion-root border-y border-slate-200/70 bg-slate-50/70 py-12 dark:border-brand-purple/15 dark:bg-white/5 sm:py-14 lg:py-16">
  <div class="services-chibi-content mx-auto w-full max-w-[1120px] px-4 sm:px-6">
    <SectionHeader content={content.header} className="mb-6 grid gap-3" headingTag="h2" />
    <div class="services-anime-grid grid w-full max-w-[1040px] gap-6 md:grid-cols-3">
      {content.cards.map((card) => (
        <ServiceCard title={card.title} description={card.description} />
      ))}
    </div>
    <div class="services-anime-cta-wrap">
      <a class="services-anime-cta" href={content.cta.href}>
        {content.cta.label}
        <span class="services-anime-cta-arrow" aria-hidden="true">{content.ctaIcon}</span>
      </a>
    </div>
  </div>
</section>

