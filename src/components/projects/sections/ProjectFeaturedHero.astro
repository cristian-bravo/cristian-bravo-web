---
import type {
  ProjectActionContent,
  ProjectFeaturedHeroContent,
  ProjectGalleryItemContent,
  ProjectReferenceContent,
} from '../../../data/es/projects';
import type { Lang } from '../../../data';

interface Props {
  project: ProjectReferenceContent;
  projectActions: ProjectActionContent[];
  featuredHero: ProjectFeaturedHeroContent;
  groupTitle: string;
  stepIndex: number;
  totalProjects: number;
  wideItem?: ProjectGalleryItemContent;
  squareItem?: ProjectGalleryItemContent;
  tallItem?: ProjectGalleryItemContent;
  lang?: Lang;
}

const {
  project,
  projectActions,
  featuredHero,
  groupTitle,
  stepIndex,
  totalProjects,
  wideItem,
  squareItem,
  tallItem,
  lang = 'es',
} = Astro.props;

const featuredDescriptionLines = featuredHero.shortDescription
  .split('\n')
  .map((line) => line.trim())
  .filter(Boolean);

const featuredStatusPills = featuredHero.statusPills?.filter(Boolean) ?? [];
const featuredTags = featuredHero.tags ?? project.tags;
const hasFeaturedActionBar = projectActions.length > 0 || Boolean(project.githubUrl);
const githubMarkPath =
  'M8 0C3.58 0 0 3.58 0 8a8.001 8.001 0 005.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.001 8.001 0 0016 8c0-4.42-3.58-8-8-8z';

const featureTheme =
  featuredHero.variant === 'industrial-corporate'
    ? 'industrial'
    : featuredHero.variant === 'retail-commerce'
      ? 'retail'
      : featuredHero.variant === 'academic-platform'
        ? 'academic'
      : featuredHero.variant === 'confidential-private'
        ? 'confidential'
      : 'edu';

const isConfidentialFeature = featureTheme === 'confidential';
const actionOfLabel = lang === 'en' ? 'for' : 'de';
const heroLabel = lang === 'en' ? `Project hero ${project.title}` : `Hero del proyecto ${project.title}`;
const repositoryLabel = lang === 'en' ? 'Repository' : 'Repositorio';
const openRepositoryLabel = lang === 'en' ? `Open repository for ${project.title}` : `Abrir repositorio de ${project.title}`;
const capabilitiesLabel = lang === 'en' ? `Capabilities for ${project.title}` : `Capacidades de ${project.title}`;
const confidentialFeatureToneClass =
  isConfidentialFeature && featuredHero.visualTone === 'violet'
    ? 'ps-project-feature--tone-violet'
    : undefined;
const visualsLabel = isConfidentialFeature
  ? lang === 'en'
    ? `Confidential representation of ${project.title}`
    : `Representacion confidencial de ${project.title}`
  : lang === 'en'
    ? `${project.title} gallery`
    : `Galeria de ${project.title}`;
const confidentialHeroPanels =
  lang === 'en'
    ? {
        lead: {
          chip: 'NDA',
          primaryLabel: 'Secure channel',
          primaryValue: 'API / Sync',
          secondaryLabel: 'Status',
          secondaryValue: 'Internal',
          meta: 'Restricted access',
        },
        square: {
          chip: 'SYNC',
          primaryLabel: 'Integrity',
          primaryValue: 'Encrypted',
          secondaryLabel: 'Flow',
          secondaryValue: 'Private',
          meta: 'Protected integrity',
        },
        tall: {
          chip: 'OPS',
          primaryLabel: 'Environment',
          primaryValue: 'Internal',
          secondaryLabel: 'Control',
          secondaryValue: 'Audited',
          meta: 'Internal system',
        },
      }
    : {
        lead: {
          chip: 'NDA',
          primaryLabel: 'Canal seguro',
          primaryValue: 'API / Sync',
          secondaryLabel: 'Estado',
          secondaryValue: 'Interno',
          meta: 'Acceso restringido',
        },
        square: {
          chip: 'SYNC',
          primaryLabel: 'Integridad',
          primaryValue: 'Cifrado',
          secondaryLabel: 'Trama',
          secondaryValue: 'Privada',
          meta: 'Integridad protegida',
        },
        tall: {
          chip: 'OPS',
          primaryLabel: 'Ambiente',
          primaryValue: 'Interno',
          secondaryLabel: 'Control',
          secondaryValue: 'Auditado',
          meta: 'Sistema interno',
        },
      };
---

<section
  class:list={[
    'ps-project-feature',
    `ps-project-feature--${featureTheme}`,
    confidentialFeatureToneClass,
  ]}
  aria-label={heroLabel}
>
  <div class="ps-project-feature__surface">
    {featuredHero.decorativeSrc && featuredHero.decorativePlacement && (
      <img
        src={featuredHero.decorativeSrc}
        alt=""
        class:list={[
          'ps-project-feature__decor',
          `ps-project-feature__decor--${featuredHero.decorativePlacement}`,
        ]}
        loading="eager"
        decoding="async"
        aria-hidden="true"
      />
    )}

    <div class="ps-project-feature__copy">
      <div class="ps-project__meta ps-project__meta--featured" data-reveal>
        <span class="ps-project__step">
          {String(stepIndex + 1).padStart(2, '0')} / {String(totalProjects).padStart(2, '0')}
        </span>
        <span class="ps-project__separator" aria-hidden="true">&middot;</span>
        <span class="ps-project__group">{groupTitle}</span>
        <span
          class:list={[
            'ps-project__visibility',
            project.isConfidential
              ? 'ps-project__visibility--private'
              : 'ps-project__visibility--public',
          ]}
        >
          {project.visibility}
        </span>
      </div>

      <p class="ps-project-feature__badge" data-reveal>
        {featuredHero.badge}
      </p>

      <h2 class="ps-project-feature__title" data-reveal>
        {project.title}
      </h2>

      {featuredHero.subtitle && (
        <p class="ps-project-feature__subtitle" data-reveal>
          {featuredHero.subtitle}
        </p>
      )}

      <p class="ps-project-feature__desc" data-reveal>
        {featuredDescriptionLines.map((line) => (
          <span class="ps-project-feature__desc-line">{line}</span>
        ))}
      </p>

      {featuredStatusPills.length > 0 ? (
        <div class="ps-project-feature__status-row" data-reveal>
          {featuredStatusPills.map((pill) => (
            <span class="ps-project-feature__status" aria-disabled="true">
              {pill}
            </span>
          ))}
        </div>
      ) : hasFeaturedActionBar && (
        <div class="ps-project-feature__actions" data-reveal>
          {projectActions.map((action, actionIndex) => (
            <a
              href={action.href}
              class:list={[
                'ps-project-feature__action',
                action.variant === 'primary' && actionIndex === 0
                  ? 'ps-project-feature__action--primary'
                  : 'ps-project-feature__action--secondary',
              ]}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${action.label} ${actionOfLabel} ${project.title}`}
            >
              {action.label}
            </a>
          ))}

          {project.githubUrl && (
            <a
              href={project.githubUrl}
              class:list={[
                'ps-project-feature__action',
                'ps-project-feature__action--secondary',
                'ps-project-feature__action--github',
              ]}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={openRepositoryLabel}
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="currentColor"
                aria-hidden="true"
                class="ps-project-feature__action-icon"
              >
                <path d={githubMarkPath} />
              </svg>
              {repositoryLabel}
            </a>
          )}
        </div>
      )}

      <ul class="ps-project-feature__tags" data-reveal aria-label={capabilitiesLabel}>
        {featuredTags.map((tag) => (
          <li class="ps-project-feature__tag">{tag}</li>
        ))}
      </ul>
    </div>

    <div class="ps-project-feature__visuals" aria-label={visualsLabel}>
      {wideItem && (
        <div class="ps-project-feature__card-shell ps-project-feature__card-shell--lead" data-reveal>
          <figure class="ps-project-feature__card">
            {wideItem.src ? (
              <img
                src={wideItem.src}
                alt={wideItem.alt}
                class="ps-project-feature__image"
                loading="eager"
                decoding="async"
              />
            ) : isConfidentialFeature ? (
              <div class="ps-project-feature__placeholder ps-project-feature__placeholder--confidential">
                <div class="ps-project-feature__private-layout" aria-hidden="true">
                  <div class="ps-project-feature__private-head">
                    <span class="ps-project-feature__private-lock">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M17 10h-1V8a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2Zm-7-2a2 2 0 1 1 4 0v2h-4V8Z" />
                      </svg>
                    </span>
                    <span class="ps-project-feature__private-chip">
                      {confidentialHeroPanels.lead.chip}
                    </span>
                  </div>
                  <div class="ps-project-feature__private-surface">
                    <div class="ps-project-feature__private-panels">
                      <span class="ps-project-feature__private-panel">
                        <span class="ps-project-feature__private-panel-label">
                          {confidentialHeroPanels.lead.primaryLabel}
                        </span>
                        <span class="ps-project-feature__private-panel-value">
                          {confidentialHeroPanels.lead.primaryValue}
                        </span>
                      </span>
                      <span class="ps-project-feature__private-panel ps-project-feature__private-panel--muted">
                        <span class="ps-project-feature__private-panel-label">
                          {confidentialHeroPanels.lead.secondaryLabel}
                        </span>
                        <span class="ps-project-feature__private-panel-value">
                          {confidentialHeroPanels.lead.secondaryValue}
                        </span>
                      </span>
                    </div>
                    <div class="ps-project-feature__private-bars">
                      <span class="ps-project-feature__private-bar ps-project-feature__private-bar--short"></span>
                      <span class="ps-project-feature__private-bar"></span>
                      <span class="ps-project-feature__private-bar ps-project-feature__private-bar--mid"></span>
                    </div>
                    <div class="ps-project-feature__private-diagram">
                      <span class="ps-project-feature__private-node"></span>
                      <span class="ps-project-feature__private-link ps-project-feature__private-link--one"></span>
                      <span class="ps-project-feature__private-node ps-project-feature__private-node--accent"></span>
                      <span class="ps-project-feature__private-link ps-project-feature__private-link--two"></span>
                      <span class="ps-project-feature__private-node"></span>
                    </div>
                  </div>
                  <div class="ps-project-feature__private-copy">
                    <span class="ps-project-feature__private-title">{wideItem.caption}</span>
                    <span class="ps-project-feature__private-meta">
                      {confidentialHeroPanels.lead.meta}
                    </span>
                  </div>
                </div>
              </div>
            ) : (
              <div class="ps-project-feature__placeholder">{wideItem.caption}</div>
            )}
          </figure>
        </div>
      )}

      {squareItem && (
        <div class="ps-project-feature__card-shell ps-project-feature__card-shell--secondary" data-reveal>
          <figure class="ps-project-feature__card">
            {squareItem.src ? (
              <img
                src={squareItem.src}
                alt={squareItem.alt}
                class="ps-project-feature__image"
                loading="eager"
                decoding="async"
              />
            ) : isConfidentialFeature ? (
              <div class="ps-project-feature__placeholder ps-project-feature__placeholder--confidential">
                <div class="ps-project-feature__private-layout" aria-hidden="true">
                  <div class="ps-project-feature__private-head">
                    <span class="ps-project-feature__private-lock">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M17 10h-1V8a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2Zm-7-2a2 2 0 1 1 4 0v2h-4V8Z" />
                      </svg>
                    </span>
                    <span class="ps-project-feature__private-chip">
                      {confidentialHeroPanels.square.chip}
                    </span>
                  </div>
                  <div class="ps-project-feature__private-surface">
                    <div class="ps-project-feature__private-panels">
                      <span class="ps-project-feature__private-panel">
                        <span class="ps-project-feature__private-panel-label">
                          {confidentialHeroPanels.square.primaryLabel}
                        </span>
                        <span class="ps-project-feature__private-panel-value">
                          {confidentialHeroPanels.square.primaryValue}
                        </span>
                      </span>
                      <span class="ps-project-feature__private-panel ps-project-feature__private-panel--muted">
                        <span class="ps-project-feature__private-panel-label">
                          {confidentialHeroPanels.square.secondaryLabel}
                        </span>
                        <span class="ps-project-feature__private-panel-value">
                          {confidentialHeroPanels.square.secondaryValue}
                        </span>
                      </span>
                    </div>
                    <div class="ps-project-feature__private-bars">
                      <span class="ps-project-feature__private-bar ps-project-feature__private-bar--short"></span>
                      <span class="ps-project-feature__private-bar"></span>
                      <span class="ps-project-feature__private-bar ps-project-feature__private-bar--mid"></span>
                    </div>
                    <div class="ps-project-feature__private-diagram">
                      <span class="ps-project-feature__private-node"></span>
                      <span class="ps-project-feature__private-link ps-project-feature__private-link--one"></span>
                      <span class="ps-project-feature__private-node ps-project-feature__private-node--accent"></span>
                      <span class="ps-project-feature__private-link ps-project-feature__private-link--two"></span>
                      <span class="ps-project-feature__private-node"></span>
                    </div>
                  </div>
                  <div class="ps-project-feature__private-copy">
                    <span class="ps-project-feature__private-title">{squareItem.caption}</span>
                    <span class="ps-project-feature__private-meta">
                      {confidentialHeroPanels.square.meta}
                    </span>
                  </div>
                </div>
              </div>
            ) : (
              <div class="ps-project-feature__placeholder">{squareItem.caption}</div>
            )}
          </figure>
        </div>
      )}

      {tallItem && (
        <div class="ps-project-feature__card-shell ps-project-feature__card-shell--tertiary" data-reveal>
          <figure class="ps-project-feature__card">
            {tallItem.src ? (
              <img
                src={tallItem.src}
                alt={tallItem.alt}
                class="ps-project-feature__image"
                loading="eager"
                decoding="async"
              />
            ) : isConfidentialFeature ? (
              <div class="ps-project-feature__placeholder ps-project-feature__placeholder--confidential">
                <div class="ps-project-feature__private-layout" aria-hidden="true">
                  <div class="ps-project-feature__private-head">
                    <span class="ps-project-feature__private-lock">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M17 10h-1V8a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2Zm-7-2a2 2 0 1 1 4 0v2h-4V8Z" />
                      </svg>
                    </span>
                    <span class="ps-project-feature__private-chip">
                      {confidentialHeroPanels.tall.chip}
                    </span>
                  </div>
                  <div class="ps-project-feature__private-surface">
                    <div class="ps-project-feature__private-panels">
                      <span class="ps-project-feature__private-panel">
                        <span class="ps-project-feature__private-panel-label">
                          {confidentialHeroPanels.tall.primaryLabel}
                        </span>
                        <span class="ps-project-feature__private-panel-value">
                          {confidentialHeroPanels.tall.primaryValue}
                        </span>
                      </span>
                      <span class="ps-project-feature__private-panel ps-project-feature__private-panel--muted">
                        <span class="ps-project-feature__private-panel-label">
                          {confidentialHeroPanels.tall.secondaryLabel}
                        </span>
                        <span class="ps-project-feature__private-panel-value">
                          {confidentialHeroPanels.tall.secondaryValue}
                        </span>
                      </span>
                    </div>
                    <div class="ps-project-feature__private-bars">
                      <span class="ps-project-feature__private-bar ps-project-feature__private-bar--short"></span>
                      <span class="ps-project-feature__private-bar"></span>
                      <span class="ps-project-feature__private-bar ps-project-feature__private-bar--mid"></span>
                    </div>
                    <div class="ps-project-feature__private-diagram">
                      <span class="ps-project-feature__private-node"></span>
                      <span class="ps-project-feature__private-link ps-project-feature__private-link--one"></span>
                      <span class="ps-project-feature__private-node ps-project-feature__private-node--accent"></span>
                      <span class="ps-project-feature__private-link ps-project-feature__private-link--two"></span>
                      <span class="ps-project-feature__private-node"></span>
                    </div>
                  </div>
                  <div class="ps-project-feature__private-copy">
                    <span class="ps-project-feature__private-title">{tallItem.caption}</span>
                    <span class="ps-project-feature__private-meta">
                      {confidentialHeroPanels.tall.meta}
                    </span>
                  </div>
                </div>
              </div>
            ) : (
              <div class="ps-project-feature__placeholder">{tallItem.caption}</div>
            )}
          </figure>
        </div>
      )}
    </div>
  </div>
</section>
