---
import type { ProfileAvatarContent } from '../../data';

interface Props {
  content: Pick<ProfileAvatarContent, 'imageSrc' | 'imageAlt' | 'role' | 'traits'>;
}

const { content } = Astro.props;
---
<article class="profile-identity-card">
  <div class="profile-identity-card__image-wrap">
    <img
      src={content.imageSrc}
      alt={content.imageAlt}
      width="1024"
      height="1024"
      loading="eager"
      decoding="async"
    />
  </div>

  <p class="profile-identity-card__role">{content.role}</p>
  <div class="profile-identity-card__traits">
    {content.traits.map((trait) => (
      <span class="profile-identity-card__chip">{trait}</span>
    ))}
  </div>
</article>

<style>
  .profile-identity-card {
    display: grid;
    gap: var(--identity-card-gap, 0.85rem);
    width: 100%;
    min-width: 0;
    max-width: var(--identity-card-max-width, 22rem);
    border-radius: 1.8rem;
    border: 1px solid rgba(148, 163, 184, 0.22);
    background: rgba(28, 25, 23, 0.76);
    box-shadow:
      0 18px 34px rgba(2, 6, 23, 0.26),
      inset 0 1px 1px rgba(255, 255, 255, 0.08);
    padding: var(--identity-card-padding, clamp(0.9rem, 2vw, 1.2rem));
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .profile-identity-card__image-wrap {
    overflow: hidden;
    border-radius: 1.45rem;
    border: 1px solid rgba(148, 163, 184, 0.16);
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.08), rgba(245, 245, 244, 0.04));
  }

  .profile-identity-card__image-wrap img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: var(--identity-card-image-ratio, 5 / 6);
  }

  .profile-identity-card__role {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(226, 232, 240, 0.9);
    text-align: center;
  }

  .profile-identity-card__traits {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .profile-identity-card__chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 1.95rem;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.18);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.35rem 0.82rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: #f5f5f4;
  }

  @media (max-width: 767px) {
    .profile-identity-card {
      max-width: var(--identity-card-max-width, none);
    }
  }
</style>
