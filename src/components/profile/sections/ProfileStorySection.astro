---
import SectionHeader from '../../shared/SectionHeader.astro';
import type { ProfileStoryContent } from '../../../data';

interface Props {
  content: ProfileStoryContent;
}

const { content } = Astro.props;
---
<section class="profile-story-section py-16 sm:py-20 lg:py-24">
  <div class="mx-auto w-full max-w-[1180px] px-4 sm:px-6">
    <SectionHeader
      content={content.header}
      className="mb-8 grid gap-3"
      headingTag="h2"
      titleClassName="font-display text-3xl font-semibold tracking-tight text-transparent sm:text-4xl bg-gradient-to-r from-brand-purple via-brand-blue to-brand-purple bg-clip-text"
      descriptionClassName="max-w-3xl text-base text-slate-600 dark:text-brand-muted sm:text-lg"
    />

    <div class="profile-story-layout">
      <article class="profile-story-panel">
        <div class="profile-story-columns">
          <div class="grid gap-4">
            <h3 class="font-display text-2xl font-semibold tracking-tight text-slate-900 dark:text-brand-text">
              {content.introTitle}
            </h3>
            {content.introParagraphs.map((paragraph) => (
              <p class="profile-story-copy">{paragraph}</p>
            ))}
          </div>

          <div class="grid gap-4">
            <h3 class="font-display text-2xl font-semibold tracking-tight text-slate-900 dark:text-brand-text">
              {content.originTitle}
            </h3>
            {content.originParagraphs.map((paragraph) => (
              <p class="profile-story-copy">{paragraph}</p>
            ))}
          </div>
        </div>

        <figure class="profile-story-quote">
          <blockquote class="profile-story-quote-text">{content.quote}</blockquote>
          <figcaption class="profile-story-quote-author">{content.quoteAuthor}</figcaption>
        </figure>
      </article>

      <div class="profile-companion-grid">
        {content.companions.map((companion) => (
          <article class="profile-companion-card">
            <div class="profile-companion-media">
              <img
                src={companion.src}
                alt=""
                width="320"
                height="320"
                loading="lazy"
                decoding="async"
              />
            </div>
            <h3 class="profile-companion-title font-display font-semibold text-slate-900 dark:text-brand-text">
              {companion.title}
            </h3>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

