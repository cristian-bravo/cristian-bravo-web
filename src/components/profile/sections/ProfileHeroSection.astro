---
import type { ProfileHeroContent } from '../../../data';

interface Props {
  content: ProfileHeroContent;
}

const { content } = Astro.props;
const lightMediaType = content.lightMediaSrc.endsWith('.html')
  ? 'html'
  : /\.(mp4|webm|ogg)$/i.test(content.lightMediaSrc)
    ? 'video'
    : 'image';
const darkMediaType = content.darkMediaSrc.endsWith('.html')
  ? 'html'
  : /\.(mp4|webm|ogg)$/i.test(content.darkMediaSrc)
    ? 'video'
    : 'image';
const isExternalLink = (href: string) => /^https?:\/\//i.test(href);
const getQuickLinkIcon = (icon: 'github' | 'linkedin' | 'email' | 'cv') => {
  if (icon === 'github') {
    return '/icons/github-mark.svg';
  }

  if (icon === 'linkedin') {
    return '/icons/linkedin-light.webp';
  }

  if (icon === 'email') {
    return '/icons/outlook_icon.webp';
  }

  return '/icons/PDF_file_icon.svg';
};
---
<section class="profile-hero-section" data-profile-hero>
  <div class="profile-hero-layout">
    {lightMediaType === 'html' ? (
      <iframe
        class:list={['profile-hero-background', 'profile-hero-background--light', 'is-embed']}
        src={content.lightMediaSrc}
        title={`${content.videoTitle} claro`}
        loading="eager"
        tabindex="-1"
        aria-hidden="true"
      ></iframe>
    ) : lightMediaType === 'image' ? (
      <img
        class:list={['profile-hero-background', 'profile-hero-background--light', 'is-image']}
        src={content.lightMediaSrc}
        alt=""
        loading="eager"
        decoding="async"
        fetchpriority="high"
        aria-hidden="true"
      />
    ) : (
      <video
        class:list={['profile-hero-background', 'profile-hero-background--light', 'is-video']}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={content.lightMediaPoster}
        aria-hidden="true"
      >
        <source src={content.lightMediaSrc} type="video/mp4" />
      </video>
    )}
    {darkMediaType === 'html' ? (
      <iframe
        class:list={['profile-hero-background', 'profile-hero-background--dark', 'is-embed']}
        src={content.darkMediaSrc}
        title={`${content.videoTitle} oscuro`}
        loading="eager"
        tabindex="-1"
        aria-hidden="true"
      ></iframe>
    ) : darkMediaType === 'image' ? (
      <img
        class:list={['profile-hero-background', 'profile-hero-background--dark', 'is-image']}
        src={content.darkMediaSrc}
        alt=""
        loading="eager"
        decoding="async"
        fetchpriority="high"
        aria-hidden="true"
      />
    ) : (
      <video
        class:list={['profile-hero-background', 'profile-hero-background--dark', 'is-video']}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={content.darkMediaPoster}
        aria-hidden="true"
      >
        <source src={content.darkMediaSrc} type="video/mp4" />
      </video>
    )}
    <div class="profile-hero-layout-overlay" aria-hidden="true"></div>
  </div>
  <div class="profile-hero-avatar-layer">
    <div class="profile-hero-shell">
      <slot />
      {content.quickLinks.length > 0 && (
        <nav class="profile-hero-quick-links" aria-label="Accesos rapidos del perfil">
          {content.quickLinks.map((link, index) => {
            const external = isExternalLink(link.href);
            const iconAsset = getQuickLinkIcon(link.icon);

            return (
              <a
                class:list={['profile-hero-quick-link', `is-${link.position}`, `is-icon-${link.icon}`]}
                href={link.href}
                aria-label={link.ariaLabel}
                data-profile-quick-link
                data-profile-quick-link-depth={String(index + 1)}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
                download={link.download ? true : undefined}
                style={`--profile-quick-link-delay: ${index * -0.8}s;`}
              >
                <span class="profile-hero-quick-link__surface">
                  <span class="profile-hero-quick-link__icon" aria-hidden="true">
                    <img
                      src={iconAsset}
                      alt=""
                      class="profile-hero-quick-link__img"
                      loading="eager"
                      decoding="async"
                    />
                  </span>
                </span>
                <span class="profile-hero-quick-link__tooltip" aria-hidden="true">{link.label}</span>
              </a>
            );
          })}
        </nav>
      )}
    </div>
  </div>
</section>

