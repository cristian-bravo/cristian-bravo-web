---
import type { ProfileHeroContent } from '../../../data';

interface Props {
  content: ProfileHeroContent;
}

const { content } = Astro.props;
const mediaType = content.videoSrc.endsWith('.html')
  ? 'html'
  : /\.(mp4|webm|ogg)$/i.test(content.videoSrc)
    ? 'video'
    : 'image';
const isExternalLink = (href: string) => /^https?:\/\//i.test(href);
---
<section class="profile-hero-section" data-profile-hero>
  <div class="profile-hero-layout">
    {mediaType === 'html' ? (
      <iframe
        class:list={['profile-hero-video', 'is-embed']}
        src={content.videoSrc}
        title={content.videoTitle}
        loading="eager"
        tabindex="-1"
        aria-hidden="true"
      ></iframe>
    ) : mediaType === 'image' ? (
      <img
        class:list={['profile-hero-video', 'is-image']}
        src={content.videoSrc}
        alt=""
        loading="eager"
        decoding="async"
        fetchpriority="high"
        aria-hidden="true"
      />
    ) : (
      <video
        class:list={['profile-hero-video', 'is-video']}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={content.videoPoster}
        aria-hidden="true"
      >
        <source src={content.videoSrc} type="video/mp4" />
      </video>
    )}
    <div class="profile-hero-layout-overlay" aria-hidden="true"></div>
  </div>
  <div class="profile-hero-avatar-layer">
    <div class="profile-hero-shell">
      <slot />
      {content.quickLinks.length > 0 && (
        <nav class="profile-hero-quick-links" aria-label="Accesos rapidos del perfil">
          {content.quickLinks.map((link, index) => {
            const external = isExternalLink(link.href);

            return (
              <a
                class:list={['profile-hero-quick-link', `is-${link.position}`]}
                href={link.href}
                aria-label={link.ariaLabel}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
                download={link.download ? true : undefined}
                style={`--profile-quick-link-delay: ${index * -0.8}s;`}
              >
                <span class="profile-hero-quick-link__surface">
                  <span class="profile-hero-quick-link__icon" aria-hidden="true">
                    {link.icon === 'github' && (
                      <svg viewBox="0 0 24 24" fill="currentColor" role="presentation">
                        <path d="M12 2C6.48 2 2 6.58 2 12.24c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-1.04-.01-1.88-2.78.62-3.37-1.21-3.37-1.21-.46-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .08 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.67.35-1.12.64-1.38-2.22-.26-4.56-1.15-4.56-5.11 0-1.13.39-2.05 1.03-2.78-.1-.26-.45-1.31.1-2.74 0 0 .84-.28 2.75 1.06A9.3 9.3 0 0 1 12 6.8c.85 0 1.71.12 2.51.36 1.9-1.34 2.74-1.06 2.74-1.06.55 1.43.2 2.48.1 2.74.64.73 1.03 1.65 1.03 2.78 0 3.97-2.34 4.85-4.57 5.1.36.32.68.95.68 1.91 0 1.38-.01 2.49-.01 2.82 0 .27.18.59.69.49A10.26 10.26 0 0 0 22 12.24C22 6.58 17.52 2 12 2Z" />
                      </svg>
                    )}
                    {link.icon === 'linkedin' && (
                      <svg viewBox="0 0 24 24" fill="currentColor" role="presentation">
                        <path d="M6.94 8.5A1.56 1.56 0 1 1 6.93 5.4a1.56 1.56 0 0 1 .01 3.11ZM5.6 9.68h2.68V18H5.6V9.68Zm4.36 0h2.57v1.14h.04c.36-.68 1.24-1.39 2.56-1.39 2.74 0 3.25 1.88 3.25 4.33V18h-2.67v-3.77c0-.9-.02-2.06-1.21-2.06-1.22 0-1.41.99-1.41 2V18H9.96V9.68Z" />
                      </svg>
                    )}
                    {link.icon === 'email' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" role="presentation">
                        <path d="M4.5 6.75h15A1.75 1.75 0 0 1 21.25 8.5v7A1.75 1.75 0 0 1 19.5 17.25h-15A1.75 1.75 0 0 1 2.75 15.5v-7A1.75 1.75 0 0 1 4.5 6.75Z" />
                        <path d="m3.4 8.1 7.67 5.52a1.6 1.6 0 0 0 1.86 0l7.67-5.52" />
                      </svg>
                    )}
                    {link.icon === 'cv' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" role="presentation">
                        <path d="M8 3.75h6.75l4.5 4.5V19.5A1.75 1.75 0 0 1 17.5 21.25h-9A1.75 1.75 0 0 1 6.75 19.5v-14A1.75 1.75 0 0 1 8.5 3.75Z" />
                        <path d="M14.75 3.75v4.5h4.5" />
                        <path d="M9 12.25h6M9 15.25h4.5M9 9.25h2.25" />
                      </svg>
                    )}
                  </span>
                  <span class="profile-hero-quick-link__label">{link.label}</span>
                </span>
              </a>
            );
          })}
        </nav>
      )}
    </div>
  </div>
</section>

