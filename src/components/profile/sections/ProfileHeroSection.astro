---
import type { ProfileAvatarContent, ProfileHeroContent } from '../../../data';

interface Props {
  content: ProfileHeroContent;
  introduction?: Pick<ProfileAvatarContent, 'role' | 'description'>;
}

const { content, introduction } = Astro.props;
const lightMediaType = content.lightMediaSrc.endsWith('.html')
  ? 'html'
  : /\.(mp4|webm|ogg)$/i.test(content.lightMediaSrc)
    ? 'video'
    : 'image';
const darkMediaType = content.darkMediaSrc.endsWith('.html')
  ? 'html'
  : /\.(mp4|webm|ogg)$/i.test(content.darkMediaSrc)
    ? 'video'
    : 'image';
const isExternalLink = (href: string) => /^https?:\/\//i.test(href);
const getQuickLinkIcon = (icon: 'github' | 'linkedin' | 'email' | 'cv') => {
  if (icon === 'github') {
    return '/icons/github-mark.svg';
  }

  if (icon === 'linkedin') {
    return '/icons/linkedin-light.webp';
  }

  if (icon === 'email') {
    return '/icons/outlook_icon.webp';
  }

  return '/icons/PDF_file_icon.svg';
};
---
<section
  class:list={['profile-hero-section', !Astro.slots.has('default') && 'profile-hero-section--wallpaper']}
  data-profile-hero
>
  <div class="profile-hero-layout">
    {lightMediaType === 'html' ? (
      <iframe
        class:list={['profile-hero-background', 'profile-hero-background--light', 'is-embed']}
        src={content.lightMediaSrc}
        title={`${content.videoTitle} claro`}
        loading="eager"
        tabindex="-1"
        aria-hidden="true"
      ></iframe>
    ) : lightMediaType === 'image' ? (
      <img
        class:list={['profile-hero-background', 'profile-hero-background--light', 'is-image']}
        src={content.lightMediaSrc}
        alt=""
        loading="eager"
        decoding="async"
        fetchpriority="high"
        aria-hidden="true"
      />
    ) : (
      <video
        class:list={['profile-hero-background', 'profile-hero-background--light', 'is-video']}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={content.lightMediaPoster}
        aria-hidden="true"
      >
        <source src={content.lightMediaSrc} type="video/mp4" />
      </video>
    )}
    {darkMediaType === 'html' ? (
      <iframe
        class:list={['profile-hero-background', 'profile-hero-background--dark', 'is-embed']}
        src={content.darkMediaSrc}
        title={`${content.videoTitle} oscuro`}
        loading="eager"
        tabindex="-1"
        aria-hidden="true"
      ></iframe>
    ) : darkMediaType === 'image' ? (
      <img
        class:list={['profile-hero-background', 'profile-hero-background--dark', 'is-image']}
        src={content.darkMediaSrc}
        alt=""
        loading="eager"
        decoding="async"
        fetchpriority="high"
        aria-hidden="true"
      />
    ) : (
      <video
        class:list={['profile-hero-background', 'profile-hero-background--dark', 'is-video']}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={content.darkMediaPoster}
        aria-hidden="true"
      >
        <source src={content.darkMediaSrc} type="video/mp4" />
      </video>
    )}
    <div class="profile-hero-layout-overlay" aria-hidden="true"></div>
  </div>
  <div class="profile-hero-avatar-layer">
    <div class="profile-hero-shell">
      <slot />
      <div class="profile-hero-intro" data-profile-intro>
        {introduction && (<>
          <p class="profile-hero-intro__eyebrow" data-intro-reveal>{content.kicker}</p>
          <h1 class="profile-hero-intro__title" data-intro-reveal>{content.title}</h1>
          <p class="profile-hero-intro__role" data-intro-reveal>{introduction.role}</p>
          <p class="profile-hero-intro__description" data-intro-reveal>{introduction.description}</p>
          <a class="profile-hero-intro__link" href={content.secondaryAction.href} data-intro-reveal>
            {content.secondaryAction.label}
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </>)}
      {content.quickLinks.length > 0 && (
        <nav class="profile-contact-links" aria-label="Social / CV">
          {content.quickLinks.map((link) => {
            const external = isExternalLink(link.href);
            const iconAsset = getQuickLinkIcon(link.icon);

            return (
              <a
                class="profile-contact-link"
                href={link.href}
                aria-label={link.ariaLabel}
                data-profile-quick-link
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
                download={link.download ? true : undefined}
              >
                <span class="profile-contact-link__icon" aria-hidden="true">
                    <img
                      src={iconAsset}
                      alt=""
                      width="30"
                      height="30"
                      loading="eager"
                      decoding="async"
                    />
                </span>
                <span aria-hidden="true">{{ github: 'GitHub', email: 'Email', cv: 'CV', linkedin: 'LinkedIn' }[link.icon]}</span>
              </a>
            );
          })}
        </nav>
      )}
      </div>
    </div>
  </div>
</section>

<script>
  import { animate } from 'animejs/animation';

  let currentIntro: HTMLElement | null = null;
  let cleanup = () => {};

  const setupIntro = () => {
    const intro = document.querySelector<HTMLElement>('[data-profile-intro]');
    if (intro === currentIntro) return;
    cleanup();
    if (!intro) return;
    currentIntro = intro;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let animations: ReturnType<typeof animate>[] = [];
    let iconAnimations: ReturnType<typeof animate>[] = [];
    let inView = true;
    const syncIcons = () => {
      iconAnimations.forEach((animation) => {
        if (inView && !document.hidden) animation.resume();
        else animation.pause();
      });
    };
    const reveal = () => {
      animations.forEach((animation) => animation.revert());
      iconAnimations.forEach((animation) => animation.revert());
      animations = [];
      iconAnimations = [];
      if (reducedMotion.matches) return;
      animations = Array.from(intro.querySelectorAll<HTMLElement>('[data-intro-reveal]'))
        .map((element, index) => animate(element, {
          opacity: [0, 1],
          translateY: [14, 0],
          duration: 650,
          delay: 80 + index * 70,
          ease: 'outCubic',
        }));
      iconAnimations = Array.from(intro.querySelectorAll<HTMLImageElement>('.profile-contact-link__icon img'))
        .map((element, index) => animate(element, {
          translateY: [-2, 2],
          rotate: [-2, 2],
          duration: 2400 + index * 350,
          delay: index * 180,
          alternate: true,
          loop: true,
          ease: 'inOutSine',
          autoplay: false,
        }));
      syncIcons();
    };

    const observer = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      syncIcons();
    });
    observer.observe(intro);
    reveal();
    document.addEventListener('visibilitychange', syncIcons);
    reducedMotion.addEventListener('change', reveal);
    cleanup = () => {
      animations.forEach((animation) => animation.revert());
      iconAnimations.forEach((animation) => animation.revert());
      observer.disconnect();
      document.removeEventListener('visibilitychange', syncIcons);
      reducedMotion.removeEventListener('change', reveal);
      currentIntro = null;
    };
  };

  setupIntro();
  document.addEventListener('astro:page-load', setupIntro);
  document.addEventListener('astro:before-swap', () => cleanup());
</script>

