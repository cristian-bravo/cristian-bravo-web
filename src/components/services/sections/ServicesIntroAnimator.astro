---
interface Props {
  targetId: string;
}

const { targetId } = Astro.props;
---
<div data-services-intro-animator data-target-id={targetId}></div>

<script>
  const initServicesIntroAnimator = (node) => {
    if (!(node instanceof HTMLElement) || node.dataset.initialized === 'true') return;
    node.dataset.initialized = 'true';

    const targetId = node.dataset.targetId;
    if (!targetId) return;

    const section = document.getElementById(targetId);
    if (!section) return;

    const revealElements = Array.from(section.querySelectorAll('[data-intro-reveal]'));
    revealElements.forEach((element, index) => {
      if (element instanceof HTMLElement) {
        element.style.setProperty('--services-reveal-index', String(index));
      }
    });

    const markReady = () => {
      section.classList.add('services-intro--ready');
      section.classList.remove('services-intro--prepared');
      section.dataset.introAnimated = 'true';
    };

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
      markReady();
      return;
    }

    section.classList.add('services-intro--prepared');

    const observer = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];
        if (!entry?.isIntersecting) return;
        observer.disconnect();
        markReady();
      },
      {
        rootMargin: '0px 0px -12% 0px',
        threshold: 0.18,
      }
    );

    observer.observe(section);
  };

  const initAllServicesIntroAnimators = () => {
    document.querySelectorAll('[data-services-intro-animator]').forEach((node) => initServicesIntroAnimator(node));
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllServicesIntroAnimators, { once: true });
  } else {
    initAllServicesIntroAnimators();
  }

  window.addEventListener('astro:page-load', initAllServicesIntroAnimators);
</script>
