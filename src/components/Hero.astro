---
const {
  title = 'Arquitectura de software para empresas',
  subtitle =
    'Diseñamos y desarrollamos plataformas que optimizan procesos, centralizan información y escalan con tu empresa.',
  cta = 'Solicitar desarrollo',
  ctaLink = '/solicitar-desarrollo',
} = Astro.props;
---
<section class="relative overflow-hidden py-20 sm:py-24 lg:py-28">
  <div class="pointer-events-none absolute inset-0 bg-hero-glow"></div>
  <div class="mx-auto w-full max-w-[1120px] px-4 sm:px-6">
    <div class="grid items-center gap-10 lg:grid-cols-[1.1fr,0.9fr]">
      <div class="grid gap-5">
        <p class="text-xs uppercase tracking-[0.22em] text-slate-500 dark:text-brand-mutedStrong">
          CYSTEMS - Ingeniería digital
        </p>
        <h1 class="font-display text-4xl font-semibold leading-tight tracking-tight text-transparent sm:text-5xl bg-gradient-to-r from-brand-purple via-brand-blue to-brand-purple bg-clip-text">
          {title}
        </h1>
        <p class="max-w-xl text-base text-slate-600 sm:text-lg dark:text-brand-muted">{subtitle}</p>
        <div class="flex flex-wrap gap-3">
          <a
            class="inline-flex items-center justify-center rounded-full bg-brand-gradient px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-slate-900/10 transition hover:-translate-y-0.5 hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple/50 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-50 dark:shadow-glow dark:focus-visible:ring-offset-brand-bg"
            href={ctaLink}
          >
            {cta}
          </a>
          <a
            class="inline-flex items-center justify-center rounded-full border border-slate-200/70 bg-white/70 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-brand-purple/40 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple/40 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-50 dark:border-brand-purple/40 dark:bg-white/5 dark:text-brand-text dark:hover:border-brand-purple/60 dark:focus-visible:ring-offset-brand-bg"
            href="/proyectos"
          >
            Ver casos de éxito
          </a>
        </div>
        <div class="grid gap-4 border-t border-slate-200/70 pt-6 text-sm text-slate-600 dark:border-brand-purple/20 dark:text-brand-muted">
          <div>
            <p class="text-[0.7rem] uppercase tracking-[0.2em] text-slate-500 dark:text-brand-mutedStrong">Enfoque</p>
            <p class="font-semibold text-slate-900 dark:text-brand-text">
              Plataformas web, automatización y cloud
            </p>
          </div>
          <div>
            <p class="text-[0.7rem] uppercase tracking-[0.2em] text-slate-500 dark:text-brand-mutedStrong">Entrega</p>
            <p class="font-semibold text-slate-900 dark:text-brand-text">Roadmaps claros y despliegues seguros</p>
          </div>
        </div>
      </div>
      <div class="hero-visual-card group/hero-visual">
        <div class="hero-visual-noise" aria-hidden="true"></div>
        <div class="hero-visual-grid" aria-hidden="true"></div>
        <img
          src="/hero/yuki-light.png"
          alt="Vista principal de plataforma digital en modo claro"
          width="1536"
          height="1024"
          class="hero-visual-image hero-visual-image-light"
          loading="eager"
          decoding="async"
        />
        <img
          src="/hero/yuki-dark.png"
          alt=""
          aria-hidden="true"
          width="1536"
          height="1024"
          class="hero-visual-image hero-visual-image-dark"
          loading="eager"
          decoding="async"
        />
        <div class="hero-visual-vignette" aria-hidden="true"></div>
        <div class="hero-visual-meta">
          <p class="hero-visual-kicker">Capacidades clave</p>
          <h2 class="hero-visual-title">Arquitectura + producto + operación</h2>
          <div class="hero-visual-tags">
            <span>Arquitectura</span>
            <span>Integraciones</span>
            <span>Escalabilidad</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
