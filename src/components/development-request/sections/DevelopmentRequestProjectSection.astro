---
import SectionHeader from '../../shared/SectionHeader.astro';
import ProjectRequestWizard from '../forms/ProjectRequestWizard';
import type { DevelopmentProjectContent } from '../../../data/development-request';

interface Props {
  content: DevelopmentProjectContent;
}

const { content } = Astro.props;
const emailHref = `mailto:${content.contactEmail}`;
---
<section class="development-project-section pt-16 sm:pt-20 lg:pt-24">
  <div class="mx-auto w-full max-w-[1220px] px-4 sm:px-6">
    <div class="development-project-layout">
      <aside class="development-project-sidebar">
        <a class="development-back-link" href={content.returnAction.href}>
          <span aria-hidden="true">←</span>
          <span>{content.returnAction.label}</span>
        </a>

        <SectionHeader
          content={content.header}
          headingTag="h1"
          className="grid gap-4"
          titleClassName="font-display text-4xl font-semibold tracking-tight text-slate-900 dark:text-brand-text sm:text-5xl"
          descriptionClassName="max-w-xl text-base text-slate-600 dark:text-brand-muted sm:text-lg"
        />

        <article class="development-side-panel">
          <div class="grid gap-3">
            <p class="development-paper-kicker">Brief guiado</p>
            <h2 class="font-display text-2xl font-semibold tracking-tight text-slate-900 dark:text-brand-text">
              {content.sidebarTitle}
            </h2>
            <p class="text-sm leading-7 text-slate-600 dark:text-brand-muted">{content.sidebarDescription}</p>
          </div>

          <ul class="development-side-list">
            {content.sidebarHighlights.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          <div class="development-project-contact">
            <p class="text-sm font-semibold text-slate-700 dark:text-brand-text">{content.responsePromise}</p>
            <a class="development-inline-link" href={emailHref}>
              {content.contactEmail}
            </a>
          </div>
        </article>
      </aside>

      <ProjectRequestWizard client:load content={content} />
    </div>
  </div>
</section>
