---
import SectionHeader from '../../shared/SectionHeader.astro';
import type { DevelopmentRequestLandingContent } from '../../../data';

interface Props {
  content: DevelopmentRequestLandingContent;
}

const { content } = Astro.props;
---
<section class="development-request-landing-section pt-6 sm:pt-8 lg:pt-10">
  <div class="mx-auto w-full max-w-[1180px] px-4 sm:px-6">
    <div class="development-request-shell">
      <SectionHeader
        content={content.header}
        headingTag="h1"
        className="grid gap-4"
        titleClassName="font-display text-4xl font-semibold tracking-tight text-transparent sm:text-5xl lg:text-6xl bg-gradient-to-r from-brand-purple via-brand-blue to-brand-purple bg-clip-text"
        descriptionClassName="max-w-3xl text-base text-slate-600 dark:text-brand-muted sm:text-lg"
      />

      <div class="development-paper-grid">
        {content.cards.map((card, index) => (
          <a
            class="development-paper-card development-paper-card-link"
            href={card.action.href}
            style={`--paper-rotation: ${card.rotation}; --paper-delay: ${index * 140}ms;`}
          >
            <div class="development-paper-card-body">
              <div class="grid gap-3">
                <p class="development-paper-kicker">{card.kicker}</p>
                <h2 class="font-display text-3xl font-semibold tracking-tight text-slate-900 dark:text-brand-text">
                  {card.title}
                </h2>
                <p class="text-base font-semibold text-slate-700 dark:text-slate-100">{card.description}</p>
                <p class="text-sm leading-7 text-slate-600 dark:text-brand-muted">{card.detail}</p>
              </div>

              <ul class="development-paper-bullets">
                {card.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>

              <span class="development-primary-link development-paper-cta" aria-hidden="true">
                <span>{card.action.label}</span>
                <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))}
      </div>

      <article class="development-support-band">
        <div class="grid gap-3">
          <p class="development-paper-kicker">{content.supportKicker}</p>
          <h2 class="font-display text-2xl font-semibold tracking-tight text-slate-900 dark:text-brand-text sm:text-3xl">
            {content.supportTitle}
          </h2>
          <p class="max-w-2xl text-sm leading-7 text-slate-600 dark:text-brand-muted">{content.supportDescription}</p>
        </div>

        <div class="development-support-chip-row">
          {content.supportChips.map((chip) => (
            <span class="development-support-chip">{chip}</span>
          ))}
        </div>
      </article>
    </div>
  </div>
</section>

