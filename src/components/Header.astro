---
type NavLink = { href: string; label: string };

const cleanPath = (value: string | null | undefined): string => {
  if (!value) return '/';
  const normalized = value.replace(/\/+$/, '');
  return normalized || '/';
};

const pathname = cleanPath(Astro.url.pathname);
const navLinks: NavLink[] = [
  { href: '/', label: 'Inicio' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/perfil/cristian-bravo', label: 'Perfil' },
  { href: '/contacto', label: 'Contacto' },
];

const isActivePath = (href: string): boolean => {
  const target = cleanPath(href);
  if (target === '/') return pathname === '/';
  return pathname === target || pathname.startsWith(`${target}/`);
};
---

<header class="header-shell sticky top-0 z-40">
  <div class="header-container mx-auto w-full max-w-[1120px] px-4 sm:px-6">
    <div class="header-frame">
      <a class="brand-logo-link group" href="/" aria-label="Inicio CYSTEMS">
        <span class="brand-logo-aura" aria-hidden="true"></span>
        <img
          src="/logos/logo-header-black.webp"
          alt="CYSTEMS"
          class="brand-logo-img brand-logo-light"
          width="220"
          height="44"
          decoding="async"
          fetchpriority="high"
        />
        <img
          src="/logos/logo-header-ligth.webp"
          alt=""
          aria-hidden="true"
          class="brand-logo-img brand-logo-dark"
          width="220"
          height="44"
          decoding="async"
        />
      </a>

      <div class="header-center">
        <nav class="header-nav" aria-label="Principal">
          {navLinks.map((item) => {
            const isActive = isActivePath(item.href);
            return (
              <a
                class:list={['header-nav-link', isActive && 'is-active']}
                href={item.href}
                aria-current={isActive ? 'page' : undefined}
              >
                <span>{item.label}</span>
              </a>
            );
          })}
        </nav>

        <a
          class:list={['header-cta', isActivePath('/solicitar-desarrollo') && 'is-active']}
          href="/solicitar-desarrollo"
          aria-current={isActivePath('/solicitar-desarrollo') ? 'page' : undefined}
        >
          <span>Solicitar desarrollo</span>
        </a>
      </div>

      <button
        id="theme-toggle"
        data-theme-toggle
        type="button"
        class="theme-toggle-btn header-theme-toggle"
        aria-label="Activar modo oscuro"
        aria-pressed="false"
        title="Cambiar tema"
      >
        <span class="sr-only">Cambiar tema</span>
        <span class="theme-toggle-orbit" aria-hidden="true"></span>
        <span class="theme-toggle-icon theme-toggle-sun" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="12" r="4.1" />
            <path
              stroke-linecap="round"
              d="M12 1.8v2.3M12 19.9v2.3M4.3 4.3 5.9 5.9M18.1 18.1l1.6 1.6M1.8 12h2.3M19.9 12h2.3M4.3 19.7l1.6-1.6M18.1 5.9l1.6-1.6"
            />
          </svg>
        </span>
        <span class="theme-toggle-icon theme-toggle-moon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.8 14.1a8.9 8.9 0 1 1-10.9-10.9 7.2 7.2 0 0 0 10.9 10.9Z" />
          </svg>
        </span>
        <span class="theme-toggle-star theme-toggle-star-a" aria-hidden="true"></span>
        <span class="theme-toggle-star theme-toggle-star-b" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>
