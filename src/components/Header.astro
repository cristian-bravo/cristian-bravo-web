<header class="sticky top-0 z-40 border-b border-slate-200/70 bg-slate-50/75 backdrop-blur-xl dark:border-brand-purple/20 dark:bg-brand-bg/70">
  <div class="mx-auto w-full max-w-[1120px] px-4 sm:px-6">
    <div class="flex flex-col gap-4 py-4 md:flex-row md:items-center">
      <a class="flex flex-col gap-1" href="/">
        <span class="font-display text-sm font-semibold uppercase tracking-[0.3em] text-slate-900 dark:text-brand-text">
          CYSTEMS
        </span>
        <span class="text-[0.7rem] uppercase tracking-[0.2em] text-slate-500 dark:text-brand-mutedStrong">
          Transforma ideas en tecnología
        </span>
      </a>
      <div class="flex flex-1 flex-wrap items-center gap-4 md:ml-8 md:justify-end">
        <nav class="flex flex-wrap items-center gap-4 text-sm text-slate-600 dark:text-brand-muted" aria-label="Principal">
          <a
            class="relative transition-colors hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple/40 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-50 dark:hover:text-brand-text dark:focus-visible:ring-offset-brand-bg"
            href="/servicios"
          >
            Servicios
          </a>
          <a
            class="relative transition-colors hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple/40 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-50 dark:hover:text-brand-text dark:focus-visible:ring-offset-brand-bg"
            href="/proyectos"
          >
            Proyectos
          </a>
          <a
            class="relative transition-colors hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple/40 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-50 dark:hover:text-brand-text dark:focus-visible:ring-offset-brand-bg"
            href="/perfil/cristian-bravo"
          >
            Perfil
          </a>
          <a
            class="relative transition-colors hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple/40 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-50 dark:hover:text-brand-text dark:focus-visible:ring-offset-brand-bg"
            href="/contacto"
          >
            Contacto
          </a>
        </nav>
        <a
          class="inline-flex items-center justify-center rounded-full bg-brand-gradient px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-slate-900/10 transition hover:-translate-y-0.5 hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple/50 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-50 dark:shadow-glow dark:focus-visible:ring-offset-brand-bg"
          href="/solicitar-desarrollo"
        >
          Solicitar desarrollo
        </a>
        <label class="ml-auto inline-flex items-center cursor-pointer">
          <span class="sr-only">Cambiar tema</span>
          <input
            id="theme-toggle"
            data-theme-toggle
            type="checkbox"
            role="switch"
            aria-checked="true"
            aria-label="Cambiar tema"
            class="peer sr-only"
          />
          <span
            class="relative h-6 w-11 rounded-full border border-slate-200/80 bg-white/70 p-0.5 shadow-sm transition-colors duration-300 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-purple/50 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-slate-50 peer-checked:border-brand-purple/40 peer-checked:bg-gradient-to-r peer-checked:from-brand-purple/70 peer-checked:to-brand-blue/70 dark:border-brand-purple/30 dark:bg-white/5 dark:peer-focus-visible:ring-offset-brand-bg"
          >
            <span class="pointer-events-none absolute left-1 top-1 h-4 w-4 text-slate-500 transition-opacity duration-300 peer-checked:opacity-0 dark:text-brand-mutedStrong">
              <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
              </svg>
            </span>
            <span class="pointer-events-none absolute right-1 top-1 h-4 w-4 text-slate-700 opacity-0 transition-opacity duration-300 peer-checked:opacity-100 dark:text-blue-200">
              <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" stroke="currentColor" stroke-width="1.5">
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
              </svg>
            </span>
            <span
              class="block h-4 w-4 translate-x-0 rounded-full bg-white shadow transition-transform duration-300 peer-checked:translate-x-5 dark:bg-brand-text"
            ></span>
          </span>
        </label>
      </div>
    </div>
  </div>
</header>
