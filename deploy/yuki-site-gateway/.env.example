# Private Node HTTPS listener. TLS files are mounted read-only by the deployer
# and are never copied into this repository or image.
NODE_ENV=production
HOST=0.0.0.0
PORT=3443
TLS_CERT_FILE=/run/secrets/cystems-yuki-site/cert.pem
TLS_KEY_FILE=/run/secrets/cystems-yuki-site/key.pem

# Generate outside the repository and inject only through the secret manager.
YUKI_GATEWAY_TOKEN=replace-with-a-43-character-or-longer-random-token
YUKI_GATEWAY_ALLOWED_ORIGINS_JSON=["https://cystems.ec","https://www.cystems.ec"]
YUKI_GATEWAY_PATH=/v1/site-chat

# The current VPS model is intentionally pinned and allowlisted. The gateway
# never accepts a model from the caller and never pulls or downloads models.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5:0.5b
YUKI_GATEWAY_ALLOWED_MODELS_JSON=["qwen2.5:0.5b"]
YUKI_GATEWAY_OLLAMA_ALLOWED_HOSTS_JSON=["ollama"]

# Conservative single-model budget; no queue is kept in memory.
YUKI_GATEWAY_TIMEOUT_MS=18000
YUKI_GATEWAY_MAX_CONCURRENT=1
YUKI_GATEWAY_GLOBAL_RATE_LIMIT_PER_MINUTE=24
YUKI_GATEWAY_VISITOR_RATE_LIMIT_PER_MINUTE=4
YUKI_GATEWAY_MAX_TRACKED_VISITORS=2048
YUKI_GATEWAY_MAX_REQUEST_BYTES=8192
YUKI_GATEWAY_MAX_MESSAGE_CHARS=1200
YUKI_GATEWAY_MAX_PREDICT_TOKENS=192
YUKI_GATEWAY_MAX_RESPONSE_CHARS=1800
YUKI_GATEWAY_MAX_UPSTREAM_RESPONSE_BYTES=65536
