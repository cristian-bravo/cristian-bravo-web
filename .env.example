# Private SMTP config
# Used only on the server by Nodemailer
# If EMAIL_USER is Gmail, the app autodetects smtp.gmail.com:587
# You can override provider settings with SMTP_HOST / SMTP_PORT / SMTP_SECURE if needed
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_smtp_password_or_app_password
EMAIL_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
