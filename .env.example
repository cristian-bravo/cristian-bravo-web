# Private SMTP config
# Used only on the server by Nodemailer
# If EMAIL_USER is Gmail, the app autodetects smtp.gmail.com:587
# You can override provider settings with SMTP_HOST / SMTP_PORT / SMTP_SECURE if needed
# Do not define SMTP_HOST/SMTP_PORT as empty strings in production panels; omit them or set real values.
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_smtp_password_or_app_password
EMAIL_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=

# Private server-to-server bridge to Yuki's dedicated public-site endpoint.
# Never use a PUBLIC_ prefix and never expose the token to browser JavaScript.
# Enable only after the isolated deploy/yuki-site-gateway passes a real turn.
YUKI_SITE_CHAT_ENABLED=false
# Separate capability: enable only after consented history and visitor isolation
# pass a real integration test. The stateless public gateway rejects history.
YUKI_SITE_CHAT_HISTORY_ENABLED=false
YUKI_SITE_API_URL=https://assistant.example.com/v1/site-chat
YUKI_SITE_API_TOKEN=generate_a_shared_cryptographic_token_outside_the_repo
YUKI_SITE_ORIGIN=https://cystems.ec
# Required at Node startup when the private gateway uses our private CA:
# NODE_EXTRA_CA_CERTS=/run/cystems-yuki-site-ca.pem
# Test-only loopback HTTP override. It is ignored unless NODE_ENV=test.
YUKI_SITE_ALLOW_LOOPBACK_HTTP_FOR_TESTS=false

# Optional reverse-proxy trust for API rate limiting. Leave both unset unless
# the origin is reachable only through the configured proxy.
# TRUST_PROXY=cloudflare
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
